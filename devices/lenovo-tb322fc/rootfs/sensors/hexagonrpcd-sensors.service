[Unit]
Description=Qualcomm ADSP sensor registry service
BindsTo=dev-fastrpc\x2dadsp\x2dsecure.device
After=dev-fastrpc\x2dadsp\x2dsecure.device
Wants=iio-sensor-proxy.service
Before=iio-sensor-proxy.service
StartLimitIntervalSec=60
StartLimitBurst=10

[Service]
Type=exec
ExecStart=/usr/bin/hexagonrpcd -f /dev/fastrpc-adsp-secure -d adsp -s -R /var/lib/hexagonrpc
# The listener can return normally after its DSP transport disappears.
# A recreated device node does not guarantee INIT_ATTACH_SNS is ready yet.
Restart=always
RestartSec=3s
UMask=0077

[Install]
WantedBy=multi-user.target
