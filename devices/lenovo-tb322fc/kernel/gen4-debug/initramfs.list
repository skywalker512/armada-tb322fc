# TB322FC gen4 debug initramfs. No firmware. Host paths come from the environment
# (INIT, BUSYBOX) and are expanded by usr/gen_init_cpio.
dir /bin 0755 0 0
dir /sbin 0755 0 0
dir /dev 0755 0 0
dir /dev/pts 0755 0 0
dir /proc 0755 0 0
dir /sys 0755 0 0
dir /run 0755 0 0
dir /tmp 0755 0 0
file /init ${INIT} 0755 0 0
file /bin/busybox ${BUSYBOX} 0755 0 0
slink /bin/sh /bin/busybox 0777 0 0
nod /dev/console 0600 0 0 c 5 1
nod /dev/null 0666 0 0 c 1 3
nod /dev/tty 0666 0 0 c 5 0
nod /dev/tty0 0600 0 0 c 4 0
nod /dev/ptmx 0666 0 0 c 5 2
