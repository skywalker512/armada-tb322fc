+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+/* Calibrated lens control for the software ISP. */
+
+#pragma once
+
+#include <vector>
+
+#include <libcamera/control_ids.h>
+
+#include <libipa/pwl.h>
+
+#include "algorithm.h"
+
+namespace libcamera::ipa::softisp::algorithms {
+
+class Focus : public Algorithm
+{
+public:
+	int init(IPAContext &context, const ValueNode &tuningData) override;
+	int configure(IPAContext &context, const IPAConfigInfo &configInfo) override;
+	void queueRequest(IPAContext &context, uint32_t frame,
+			  IPAFrameContext &frameContext, const ControlList &controls) override;
+	void prepare(IPAContext &context, uint32_t frame,
+		     IPAFrameContext &frameContext, DebayerParams *params) override;
+	void process(IPAContext &context, uint32_t frame,
+		     IPAFrameContext &frameContext, const SwIspStats *stats,
+		     ControlList &metadata) override;
+
+private:
+	enum class Scan { Idle,
+			  Waiting,
+			  Coarse,
+			  Fine,
+			  Verify };
+	void setPosition(IPAContext &context, float position);
+	void beginPass(IPAContext &context, float min, float max, unsigned int steps);
+	void finish(IPAContext &context, controls::AfStateEnum state, bool restore);
+	void scan(IPAContext &context, const IPAFrameContext &frameContext,
+		  const SwIspStats &stats);
+	Pwl map_;
+	Pwl inverse_;
+	float default_ = 0;
+	uint32_t settlingTime_ = 0;
+	bool initialized_ = false;
+	controls::AfModeEnum mode_ = controls::AfModeManual;
+	controls::AfStateEnum state_ = controls::AfStateIdle;
+	Scan scan_ = Scan::Idle;
+	std::vector<float> positions_;
+	unsigned int index_ = 0;
+	unsigned int waitFrames_ = 0;
+	unsigned int stableFrames_ = 0;
+	unsigned int invalidFrames_ = 0;
+	unsigned int samples_ = 0;
+	double sum_ = 0;
+	double bestScore_ = 0;
+	double worstScore_ = 0;
+	float bestPosition_ = 0;
+	float startPosition_ = 0;
+	uint32_t exposure_ = 0;
+	double gain_ = 0;
+};
+
+} /* namespace libcamera::ipa::softisp::algorithms */
