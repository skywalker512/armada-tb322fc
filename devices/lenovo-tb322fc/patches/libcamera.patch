diff --git a/src/ipa/softisp/algorithms/focus.cpp b/src/ipa/softisp/algorithms/focus.cpp
new file mode 100644
index 0000000..9fae73d
--- /dev/null
+++ b/src/ipa/softisp/algorithms/focus.cpp
@@ -0,0 +1,313 @@
+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+/* Calibrated lens control for the software ISP. */
+
+#include "focus.h"
+
+#include <array>
+#include <cmath>
+#include <limits>
+
+#include <linux/videodev2.h>
+
+#include <libcamera/base/log.h>
+
+#include <libcamera/control_ids.h>
+
+#include "libcamera/internal/software_isp/swisp_stats.h"
+#include "libcamera/internal/value_node.h"
+
+namespace libcamera::ipa::softisp::algorithms {
+
+LOG_DEFINE_CATEGORY(IPASoftIspFocus)
+
+int Focus::init(IPAContext &context, const ValueNode &tuningData)
+{
+	const auto lens = context.lensControls.find(V4L2_CID_FOCUS_ABSOLUTE);
+	if (lens == context.lensControls.end())
+		return 0;
+
+	const auto &points = tuningData["map"];
+	if (!points.isList() || points.size() < 2)
+		return -EINVAL;
+
+	double previousPosition = -1;
+	double previousCode = 0;
+	int direction = 0;
+	for (const auto &point : points.asList()) {
+		if (!point.isList() || point.size() != 2)
+			return -EINVAL;
+		auto position = point[0].get<double>();
+		auto code = point[1].get<double>();
+		if (!position || !code || !std::isfinite(*position) ||
+		    !std::isfinite(*code) || *position <= previousPosition ||
+		    *position < 0 || *position > std::numeric_limits<float>::max() ||
+		    *code < 0 || *code < lens->second.min().get<int32_t>() ||
+		    *code > lens->second.max().get<int32_t>())
+			return -EINVAL;
+
+		if (!map_.empty()) {
+			int stepDirection = (*code > previousCode) - (*code < previousCode);
+			if (!stepDirection || (direction && direction != stepDirection))
+				return -EINVAL;
+			direction = stepDirection;
+		}
+		map_.append(*position, *code);
+		previousPosition = *position;
+		previousCode = *code;
+	}
+	if (map_.size() != points.size())
+		return -EINVAL;
+
+	auto defaultPosition = tuningData["default"].get<float>();
+	auto settlingTime = tuningData["settling_time"].get<uint32_t>();
+	if (!defaultPosition || !std::isfinite(*defaultPosition) ||
+	    !map_.domain().contains(*defaultPosition) || !settlingTime ||
+	    *settlingTime > 1000000)
+		return -EINVAL;
+	default_ = *defaultPosition;
+	settlingTime_ = *settlingTime;
+	auto [inverse, monotonic] = map_.inverse();
+	if (!monotonic || inverse.size() != map_.size())
+		return -EINVAL;
+	inverse_ = std::move(inverse);
+
+	context.ctrlMap[&controls::LensPosition] =
+		ControlInfo(float(map_.domain().start), float(map_.domain().end), default_);
+	const std::array<ControlValue, 2> modes{ int32_t(controls::AfModeManual),
+						 int32_t(controls::AfModeAuto) };
+	context.ctrlMap[&controls::AfMode] = ControlInfo(modes);
+	context.ctrlMap[&controls::AfTrigger] = ControlInfo(controls::AfTriggerValues);
+	return 0;
+}
+
+int Focus::configure(IPAContext &context,
+		     [[maybe_unused]] const IPAConfigInfo &configInfo)
+{
+	initialized_ = false;
+	mode_ = controls::AfModeManual;
+	state_ = controls::AfStateIdle;
+	scan_ = Scan::Idle;
+	positions_.clear();
+	context.activeState.focusExposureLocked = false;
+	context.activeState.lens = {};
+	context.activeState.lens.settlingTime = settlingTime_;
+	return 0;
+}
+
+void Focus::prepare(IPAContext &context, [[maybe_unused]] uint32_t frame,
+		    [[maybe_unused]] IPAFrameContext &frameContext,
+		    [[maybe_unused]] DebayerParams *params)
+{
+	if (!initialized_ && !map_.empty()) {
+		if (mode_ == controls::AfModeManual && context.activeState.lens.position < 0)
+			setPosition(context, default_);
+		initialized_ = true;
+	}
+}
+
+void Focus::setPosition(IPAContext &context, float position)
+{
+	auto &command = context.activeState.lens;
+	int32_t code = std::lround(map_.eval(map_.domain().clamp(position)));
+	if (command.position != code) {
+		command.position = code;
+		++command.generation;
+	}
+}
+
+void Focus::queueRequest(IPAContext &context, [[maybe_unused]] uint32_t frame,
+			 [[maybe_unused]] IPAFrameContext &frameContext,
+			 const ControlList &controls)
+{
+	if (map_.empty())
+		return;
+	if (context.startup)
+		configure(context, {});
+	const auto mode = controls.get(controls::AfMode);
+	if (mode) {
+		if (*mode != controls::AfModeManual && *mode != controls::AfModeAuto)
+			return;
+		if (*mode != mode_) {
+			mode_ = static_cast<controls::AfModeEnum>(*mode);
+			finish(context, controls::AfStateIdle, false);
+		}
+	}
+	if (mode_ == controls::AfModeManual) {
+		const auto position = controls.get(controls::LensPosition);
+		if (position && std::isfinite(*position))
+			setPosition(context, *position);
+		return;
+	}
+
+	const auto trigger = controls.get(controls::AfTrigger);
+	if (!trigger)
+		return;
+	if (*trigger == controls::AfTriggerCancel && scan_ != Scan::Idle) {
+		finish(context, controls::AfStateIdle, false);
+	} else if (*trigger == controls::AfTriggerStart && scan_ == Scan::Idle) {
+		if (context.activeState.lens.position < 0)
+			setPosition(context, default_);
+		startPosition_ = inverse_.eval(inverse_.domain().clamp(context.activeState.lens.position));
+		state_ = controls::AfStateScanning;
+		scan_ = Scan::Waiting;
+		waitFrames_ = stableFrames_ = invalidFrames_ = samples_ = 0;
+		exposure_ = 0;
+		gain_ = 0;
+		bestScore_ = 0;
+		worstScore_ = std::numeric_limits<double>::infinity();
+		bestPosition_ = startPosition_;
+	}
+}
+
+void Focus::finish(IPAContext &context, controls::AfStateEnum state, bool restore)
+{
+	state_ = state;
+	scan_ = Scan::Idle;
+	context.activeState.focusExposureLocked = false;
+	if (restore)
+		setPosition(context, startPosition_);
+}
+
+void Focus::beginPass(IPAContext &context, float min, float max, unsigned int steps)
+{
+	positions_.clear();
+	int32_t previous = -1;
+	for (unsigned int i = 0; i <= steps; ++i) {
+		float position = min + (max - min) * i / steps;
+		int32_t code = std::lround(map_.eval(map_.domain().clamp(position)));
+		if (code != previous)
+			positions_.push_back(position);
+		previous = code;
+	}
+	index_ = samples_ = waitFrames_ = 0;
+	sum_ = 0;
+	setPosition(context, positions_.front());
+}
+
+void Focus::scan(IPAContext &context, const IPAFrameContext &frameContext,
+		 const SwIspStats &stats)
+{
+	if (scan_ == Scan::Idle)
+		return;
+	/* Bound the delivered frames spent awaiting a usable sample. */
+	if (++waitFrames_ > 128) {
+		finish(context, controls::AfStateFailed, false);
+		return;
+	}
+	const auto &lens = frameContext.lens;
+	const auto &command = context.activeState.lens;
+	if (lens.generation != command.generation)
+		return;
+	if (lens.error) {
+		finish(context, controls::AfStateFailed, false);
+		return;
+	}
+	if (!lens.settled || lens.position != command.position || !stats.valid)
+		return;
+
+	const auto &focus = stats.focus;
+	double mean = focus.count ? double(focus.sum) / focus.count : 0;
+	double signal = mean - context.activeState.blc.level;
+	/* Eight levels above black exclude noise-dominated normalized gradients. */
+	bool usable = focus.count >= 16 && signal >= 8 &&
+		      uint64_t(focus.saturated) * 10 < focus.count;
+	uint32_t exposure = frameContext.sensor.exposure;
+	double gain = frameContext.sensor.gain;
+	if (!exposure || !std::isfinite(gain) || gain <= 0) {
+		finish(context, controls::AfStateFailed, false);
+		return;
+	}
+	if (scan_ == Scan::Waiting) {
+		const auto &agc = context.activeState.agc;
+		uint32_t targetExposure = agc.autoExposureEnabled ? agc.automatic.exposure : agc.manual.exposure;
+		double targetGain = agc.autoGainEnabled ? agc.automatic.gain : agc.manual.gain;
+		bool stable = std::abs(double(exposure) - exposure_) <= 1 &&
+			      std::abs(gain - gain_) <= gain * 0.01 &&
+			      std::abs(double(exposure) - targetExposure) <= 1 &&
+			      std::abs(gain - targetGain) <= gain * 0.01;
+		stableFrames_ = stable ? stableFrames_ + 1 : 1;
+		exposure_ = exposure;
+		gain_ = gain;
+		if (stableFrames_ < 2) {
+			invalidFrames_ = 0;
+			return;
+		}
+		if (!usable) {
+			if (++invalidFrames_ >= 3)
+				finish(context, controls::AfStateFailed, false);
+			return;
+		}
+		invalidFrames_ = 0;
+		context.activeState.focusExposureLocked = true;
+		scan_ = Scan::Coarse;
+		beginPass(context, map_.domain().start, map_.domain().end, 10);
+		return;
+	}
+	if (!usable) {
+		finish(context, controls::AfStateFailed, true);
+		return;
+	}
+	/* User exposure changes or an unsettled sensor invalidate a comparison. */
+	if (std::abs(double(exposure) - exposure_) > exposure_ * 0.05 ||
+	    std::abs(gain - gain_) > gain_ * 0.05) {
+		finish(context, controls::AfStateFailed, true);
+		return;
+	}
+
+	double score = double(focus.energy) / focus.count / (signal * signal);
+	sum_ += score;
+	if (++samples_ < 2)
+		return;
+	score = sum_ / samples_;
+	samples_ = 0;
+	sum_ = 0;
+	waitFrames_ = 0;
+
+	if (scan_ == Scan::Verify) {
+		bool match = score >= bestScore_ * 0.75 && score <= bestScore_ * 1.25;
+		finish(context, match ? controls::AfStateFocused : controls::AfStateFailed, !match);
+		return;
+	}
+	if (score > bestScore_) {
+		bestScore_ = score;
+		bestPosition_ = positions_[index_];
+	}
+	worstScore_ = std::min(worstScore_, score);
+	if (++index_ < positions_.size()) {
+		setPosition(context, positions_[index_]);
+		return;
+	}
+	/* Flat/noisy scenes must show a repeatable peak before declaring focus. */
+	if (bestScore_ < 0.001 || bestScore_ < worstScore_ * 1.15) {
+		finish(context, controls::AfStateFailed, true);
+		return;
+	}
+	if (scan_ == Scan::Coarse) {
+		float step = (map_.domain().end - map_.domain().start) / 10;
+		scan_ = Scan::Fine;
+		beginPass(context, map_.domain().clamp(bestPosition_ - step),
+			  map_.domain().clamp(bestPosition_ + step), 8);
+	} else {
+		scan_ = Scan::Verify;
+		setPosition(context, bestPosition_);
+	}
+}
+
+void Focus::process(IPAContext &context,
+		    [[maybe_unused]] uint32_t frame, IPAFrameContext &frameContext,
+		    const SwIspStats *stats, ControlList &metadata)
+{
+	if (map_.empty())
+		return;
+	if (stats)
+		scan(context, frameContext, *stats);
+	metadata.set(controls::AfMode, mode_);
+	metadata.set(controls::AfState, state_);
+	const auto &lens = frameContext.lens;
+	if (lens.settled && !lens.error && inverse_.domain().contains(lens.position))
+		metadata.set(controls::LensPosition, float(inverse_.eval(lens.position)));
+}
+
+REGISTER_IPA_ALGORITHM(Focus, "Focus")
+
