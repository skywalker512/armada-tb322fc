From 03d347c391aa1eecce7a940477b0369009e176a6 Mon Sep 17 00:00:00 2001
From: h0cheung <hcheunh@gmail.com>
Date: Tue, 6 Oct 2026 16:11:09 +0800
Subject: [PATCH 06/48] arm64: dts: qcom: sm8750: add GPU cooling

Unlike the CPU, the GPU does not throttle its speed automatically when it
reaches a high temperature. Add passive trips at 105 C on the gpuss0/1
thermal zones with cooling maps pointing at the GPU, so the devfreq
cooling device can cap the GPU clock.

From the upstream Adreno 830 series (Gaurav Kohli, Akhil P Oommen).
Imported from BigfootACA/linux full-v7.1.3 (4506566f41), the Xiaomi Pad 8
Pro (xiaomi-piano, SM8750) mainline tree.
---
 arch/arm64/boot/dts/qcom/sm8750.dtsi | 104 ++++++++++++++++++++-------
 1 file changed, 80 insertions(+), 24 deletions(-)

diff --git a/arch/arm64/boot/dts/qcom/sm8750.dtsi b/arch/arm64/boot/dts/qcom/sm8750.dtsi
index 2983669af..030a9676f 100644
--- a/arch/arm64/boot/dts/qcom/sm8750.dtsi
+++ b/arch/arm64/boot/dts/qcom/sm8750.dtsi
@@ -7255,10 +7255,10 @@ gpuss0-thermal {
 			thermal-sensors = <&tsens2 1>;
 
 			trips {
-				trip-point0 {
-					temperature = <120000>;
+				gpuss0_alert0: gpuss0-alert0 {
+					temperature = <105000>;
 					hysteresis = <5000>;
-					type = "hot";
+					type = "passive";
 				};
 
 				gpuss0-critical {
@@ -7267,16 +7267,23 @@ gpuss0-critical {
 					type = "critical";
 				};
 			};
+
+			cooling-maps {
+				map0 {
+					trip = <&gpuss0_alert0>;
+					cooling-device = <&gpu THERMAL_NO_LIMIT THERMAL_NO_LIMIT>;
+				};
+			};
