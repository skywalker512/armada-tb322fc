From da49f72b0328577347939636214081f6f69d5608 Mon Sep 17 00:00:00 2001
From: h0cheung <hcheunh@gmail.com>
Date: Sun, 11 Oct 2026 14:26:27 +0800
Subject: [PATCH 26/48] firmware: psci: map reboot reason to SM8750
 SYSTEM_RESET2 vendor resets

Imported from xiaquwan1001/lenovo-legion-y700-gen4-tb322fc-elden-linux patches/kernel-history/elden_vk41-psci-reboot/0003-elden-vk41-minimal-PSCI-SYSTEM_RESET2-vendor-reset-h.patch.
---
 drivers/firmware/psci/psci.c | 43 ++++++++++++++++++++++++++++++++++++
 1 file changed, 43 insertions(+)

diff --git a/drivers/firmware/psci/psci.c b/drivers/firmware/psci/psci.c
index e73bae6cb..7fa6b89aa 100644
--- a/drivers/firmware/psci/psci.c
+++ b/drivers/firmware/psci/psci.c
@@ -18,6 +18,7 @@
 #include <linux/psci.h>
 #include <linux/reboot.h>
 #include <linux/slab.h>
+#include <linux/string.h>
 #include <linux/suspend.h>
 
 #include <uapi/linux/psci.h>
@@ -306,9 +307,51 @@ static int get_set_conduit_method(const struct device_node *np)
 	return 0;
 }
 
+/*
+ * SM8750 (Lenovo "elden" TB322FC) reboot-mode -> PSCI SYSTEM_RESET2 vendor resets.
+ *
+ * Upstream drives this through the psci-reboot-mode driver plus a 13-patch
+ * reboot-mode/MFD series that is not merged as of v7.2.  This is a minimal
+ * device-side hook so that `reboot bootloader` / `reboot edl` reach firmware.
+ * reset_type/cookie values match the upstream sm8750 DT
+ * ([PATCH v22] arm64: dts: qcom: sm8750: add reboot-mode support).
+ *
+ * If the SMC returns (firmware rejected or ignored the vendor reset) we fall
+ * through to the normal reboot path, so an unsupported type cannot wedge boot.
+ */
+#define PSCI_ELDEN_RESET_TYPE_EDL		0x80000000
+#define PSCI_ELDEN_RESET_TYPE_BOOTLOADER	0x80010001
+
+static void psci_elden_try_vendor_reset(const char *cmd)
+{
+	u32 reset_type, cookie;
+
+	if (!cmd)
+		return;
+
+	if (!strcmp(cmd, "edl")) {
+		reset_type = PSCI_ELDEN_RESET_TYPE_EDL;
+		cookie = 0x1;
+	} else if (!strcmp(cmd, "bootloader")) {
+		reset_type = PSCI_ELDEN_RESET_TYPE_BOOTLOADER;
+		cookie = 0x2;
+	} else {
+		return;
+	}
+
+	pr_info("psci: SYSTEM_RESET2 vendor reset_type=0x%08x cookie=0x%x (cmd=%s)\n",
+		reset_type, cookie, cmd);
+	invoke_psci_fn(PSCI_FN_NATIVE(1_1, SYSTEM_RESET2), reset_type,
+		       cookie, 0);
+	/* Only reached if firmware did not reset the SoC. */
+}
+
 static int psci_sys_reset(struct notifier_block *nb, unsigned long action,
 			  void *data)
 {
+	if (psci_system_reset2_supported)
+		psci_elden_try_vendor_reset(data);
+
 	if ((reboot_mode == REBOOT_WARM || reboot_mode == REBOOT_SOFT) &&
 	    psci_system_reset2_supported) {
 		/*
