 	arm_smmu_master_install_s2crs(cfg, S2CR_TYPE_TRANS,
 				      smmu_domain->cfg.cbndx, fwspec);
@@ -2064,6 +2125,9 @@ static int arm_smmu_device_dt_probe(struct arm_smmu_device *smmu,
