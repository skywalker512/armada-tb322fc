@@ -0,0 +1,117 @@
+# SPDX-License-Identifier: (GPL-2.0 OR BSD-2-Clause)
+# Copyright (c) 2023 MediaTek Inc.
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/media/i2c/galaxycore,gc08a8.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: GalaxyCore gc08a8 1/4" 8M Pixel MIPI CSI-2 sensor
+
+maintainers:
+  - Elden Mainline Agent <elden-mainline@localhost>
+
+description:
+  The gc08a8 is a raw image sensor with an MIPI CSI-2 image data
+  interface and CCI (I2C compatible) control bus. The output format
+  is raw Bayer.
+
+allOf:
+  - $ref: /schemas/media/video-interface-devices.yaml#
+
+properties:
+  compatible:
+    const: galaxycore,gc08a8
+
+  reg:
+    maxItems: 1
+
+  clocks:
+    maxItems: 1
+    description: 19.2 MHz input clock.
+
+  dovdd-supply: true
+
+  avdd-supply: true
+
+  dvdd-supply: true
+
+  power-domains:
+    maxItems: 1
+
+  reset-gpios:
+    description: Reference to the GPIO connected to the RESETB pin.
+    maxItems: 1
+
+  port:
+    $ref: /schemas/graph.yaml#/$defs/port-base
+    additionalProperties: false
+    description:
+      Output port node, single endpoint describing the CSI-2 transmitter.
+
+    properties:
+      endpoint:
+        $ref: /schemas/media/video-interfaces.yaml#
+        unevaluatedProperties: false
+
+        properties:
+          data-lanes:
+            items:
+              - const: 1
+              - const: 2
+              - const: 3
+              - const: 4
+
+          link-frequencies:
+            items:
+              - const: 336000000
+
+        required:
+          - data-lanes
+          - link-frequencies
+
+    required:
+      - endpoint
+
+required:
+  - compatible
+  - reg
+  - clocks
+  - dovdd-supply
+  - avdd-supply
+  - dvdd-supply
+  - reset-gpios
+  - port
+
+unevaluatedProperties: false
+
+examples:
+  - |
+    #include <dt-bindings/gpio/gpio.h>
+
+    i2c {
+        #address-cells = <1>;
+        #size-cells = <0>;
+
+        sensor@31 {
+            compatible = "galaxycore,gc08a8";
+            reg = <0x31>;
+
+            clocks = <&gc08a8_clk>;
+
+            reset-gpios = <&pio 19 GPIO_ACTIVE_LOW>;
+
+            avdd-supply = <&gc08a8_avdd>;
+            dovdd-supply = <&gc08a8_dovdd>;
+            dvdd-supply = <&gc08a8_dvdd>;
+
+            port {
+                sensor_out: endpoint {
+                    data-lanes = <1 2 3 4>;
+                    link-frequencies = /bits/ 64 <336000000>;
+                    remote-endpoint = <&seninf_csi_port_0_in>;
+                };
+            };
+        };
+    };
+
+...
diff --git a/Documentation/devicetree/bindings/media/i2c/giantec,gt9764.yaml b/Documentation/devicetree/bindings/media/i2c/giantec,gt9764.yaml
new file mode 100644
index 000000000..7c5cc66e3
--- /dev/null
+++ b/Documentation/devicetree/bindings/media/i2c/giantec,gt9764.yaml
@@ -0,0 +1,71 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/media/i2c/giantec,gt9764.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Giantec GT9764 camera lens actuator
+
+maintainers:
+  - Elden Mainline Agent <elden-mainline@localhost>
+
+description:
+  I2C-controlled lens actuator with a 10-bit position DAC and advanced actuator
+  control (AAC). AAC parameters depend on the lens module's mechanical response.
+
+properties:
+  compatible:
+    const: giantec,gt9764
+
+  reg:
+    maxItems: 1
+
+  vddio-supply:
+    description: Digital I/O supply.
+
+  vdd-supply:
+    description: Actuator supply, independently switched for the lens.
+
+  giantec,aac-mode:
+    $ref: /schemas/types.yaml#/definitions/uint32
+    maximum: 255
+    description: Module-specified AAC mode configuration (register 0x06).
+
+  giantec,aac-timing:
+    $ref: /schemas/types.yaml#/definitions/uint32
+    maximum: 255
+    description: Module-specified AAC timing configuration (register 0x07).
+
+  settling-time-us:
+    minimum: 1
+    description:
+      Minimum interval after programming a lens position before issuing
+      another position command, based on the lens module's damping response.
+
+required:
+  - compatible
+  - reg
+  - vddio-supply
+  - vdd-supply
+  - giantec,aac-mode
+  - giantec,aac-timing
+  - settling-time-us
+
+additionalProperties: false
+
+examples:
+  - |
+    i2c {
+        #address-cells = <1>;
+        #size-cells = <0>;
+
+        lens@c {
+            compatible = "giantec,gt9764";
+            reg = <0x0c>;
+            vddio-supply = <&camera_io>;
+            vdd-supply = <&camera_af>;
+            giantec,aac-mode = <0x40>;
+            giantec,aac-timing = <0x7c>;
+            settling-time-us = <7000>;
+        };
+    };
