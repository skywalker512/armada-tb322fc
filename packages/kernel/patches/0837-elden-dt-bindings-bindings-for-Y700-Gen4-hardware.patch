+  - compatible
+  - reg
+  - clocks
+  - dovdd-supply
+  - avdd-supply
+  - dvdd-supply
+  - reset-gpios
+  - port
+
+unevaluatedProperties: false
+
+examples:
+  - |
+    #include <dt-bindings/gpio/gpio.h>
+
+    i2c {
+        #address-cells = <1>;
+        #size-cells = <0>;
+
+        sensor@56 {
+            compatible = "samsung,s5kjns";
+            reg = <0x56>;
+
+            clocks = <&s5kjns_clk>;
+
+            reset-gpios = <&pio 19 GPIO_ACTIVE_LOW>;
+
+            avdd-supply = <&s5kjns_avdd>;
+            dovdd-supply = <&s5kjns_dovdd>;
+            dvdd-supply = <&s5kjns_dvdd>;
+
