 			compatible = "qcom,sm8750-gcc";
 			reg = <0x0 0x00100000 0x0 0x1f4200>;
 
+			power-domains = <&rpmhpd RPMHPD_CX>,
+					<&rpmhpd RPMHPD_MX>;
+
 			clocks = <&bi_tcxo_div2>,
 				 <0>,
 				 <&sleep_clk>,
@@ -2368,9 +2371,16 @@ gpr {
 					#address-cells = <1>;
 					#size-cells = <0>;
 
-					q6apm: service@1 {
+					/*
+					 * The SM8750 ADSP firmware only answers the downstream
+					 * static GPR client ports (APM 3, PRM 7) and silently
+					 * drops requests from any other source port, so the
+					 * q6apm/q6prm drivers take their GPR source port from
+					 * this "reg".
+					 */
+					q6apm: service@3 {
 						compatible = "qcom,q6apm";
-						reg = <GPR_APM_MODULE_IID>;
+						reg = <3>;
 						#sound-dai-cells = <0>;
 						qcom,protection-domain = "avs/audio",
 									 "msm/adsp/audio_pd";
@@ -2387,9 +2397,9 @@ q6apmdai: dais {
 						};
 					};
 
-					q6prm: service@2 {
