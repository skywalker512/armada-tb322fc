+	  module will be called s5kjns.
+
 config VIDEO_S5KJN1
 	tristate "Samsung S5KJN1 sensor support"
 	select V4L2_CCI_I2C
@@ -918,6 +942,16 @@ config VIDEO_DW9768
 	  capability. This is designed for linear control of
 	  voice coil motors, controlled via I2C serial interface.
 
+config VIDEO_GT9764
+	tristate "Giantec GT9764 lens actuator support"
+	depends on PM
