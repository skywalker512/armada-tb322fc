index 5d173e0ec..d1e1eb97e 100644
--- a/drivers/media/i2c/Kconfig
+++ b/drivers/media/i2c/Kconfig
@@ -90,6 +90,18 @@ config VIDEO_GC05A2
 	  To compile this driver as a module, choose M here: the
 	  module will be called gc05a2.
 
+config VIDEO_GC08A8
+	tristate "GalaxyCore GC08A8 sensor support"
+	depends on I2C && VIDEO_DEV
+	select V4L2_CCI_I2C
+	select V4L2_FWNODE
+	help
+	  Support the GalaxyCore GC08A8 image sensor with a 19.2 MHz clock
+	  and four-lane MIPI CSI-2 output at 3264x2448.
+
+	  To compile this driver as a module, choose M here: the
+	  module will be called gc08a8.
+
