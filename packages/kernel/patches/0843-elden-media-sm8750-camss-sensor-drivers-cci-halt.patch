 	tristate "GalaxyCore gc08a3 sensor support"
 	select V4L2_CCI_I2C
@@ -793,6 +805,18 @@ config VIDEO_S5K6A3
 	  This is a V4L2 sensor driver for Samsung S5K6A3 raw
 	  camera sensor.
 
+config VIDEO_S5KJNS
+	tristate "Samsung S5KJNS sensor support"
+	depends on I2C && VIDEO_DEV
+	select V4L2_CCI_I2C
+	select V4L2_FWNODE
+	help
+	  Support the Samsung S5KJNS image sensor with a 19.2 MHz clock
+	  and four-lane MIPI CSI-2 output at 4080x3072.
+
