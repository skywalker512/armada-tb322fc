From 61663c094f00af13e7a067bdb6693c5bdc1631a1 Mon Sep 17 00:00:00 2001
From: h0cheung <hcheunh@gmail.com>
Date: Tue, 6 Oct 2026 16:41:00 +0800
Subject: [PATCH 09/48] arm64: dts: qcom: sm8750: reserve the low IOVA range
 for Iris

Iris reserves IOVA below 0x25800000 (600MB), primarily for secure
non-pixel buffers using different Stream IDs. DMA into that range from any
other stream ID triggers unhandled SMMU page faults that cause spontaneous
device reboots, readily reproduced with concurrent video decode streams.

Add an iommu-addresses reservation covering [0, 0x25800000) and reference
it from the Iris node so the IOMMU layer keeps allocations above it.

Imported from BigfootACA/linux full-v7.1.3 (a7c13b68d3), the Xiaomi Pad 8
Pro (xiaomi-piano, SM8750) mainline tree. Original author: Junhao Xie
<bigfoot@radxa.com>.
---
 arch/arm64/boot/dts/qcom/sm8750.dtsi | 13 ++++++++++++-
 1 file changed, 12 insertions(+), 1 deletion(-)

diff --git a/arch/arm64/boot/dts/qcom/sm8750.dtsi b/arch/arm64/boot/dts/qcom/sm8750.dtsi
index 030a9676f..b82a16652 100644
--- a/arch/arm64/boot/dts/qcom/sm8750.dtsi
+++ b/arch/arm64/boot/dts/qcom/sm8750.dtsi
@@ -572,6 +572,17 @@ adsp_rpc_remote_heap_mem: adsp-rpc-remote-heap {
 			size = <0x0 0xc00000>;
 			reusable;
 		};
+
+		/*
+		 * The Iris VPU reserves IOVA below 0x25800000 (600MB),
+		 * primarily for non-pixel buffers using different Stream IDs.
+		 * DMA into that range triggers unhandled SMMU faults and
+		 * spontaneous reboots, so reserve it to keep IOMMU
+		 * allocations above this boundary.
+		 */
+		iris_iova: iris-iova {
+			iommu-addresses = <&iris 0x0 0x0 0x0 0x25800000>;
+		};
 	};
 
 	smp2p-adsp {
@@ -2979,7 +2990,7 @@ &config_noc SLAVE_VENUS_CFG QCOM_ICC_TAG_ACTIVE_ONLY>,
 
 			interrupts = <GIC_SPI 174 IRQ_TYPE_LEVEL_HIGH>;
 
-			memory-region = <&video_mem>;
+			memory-region = <&video_mem>, <&iris_iova>;
 
 			operating-points-v2 = <&iris_opp_table>;
 
