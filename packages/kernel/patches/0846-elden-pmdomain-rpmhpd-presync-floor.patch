From: GEEKiDoS <geek_ds@foxmail.com>
Date: Wed, 14 Oct 2026 20:46:16 +0800
Subject: [PATCH 44/48] elden: pmdomain: rpmhpd presync floor

split from 0001; preserves Armada's lowest-functional-corner comment
---
 drivers/pmdomain/qcom/rpmhpd.c | 16 ++++++++++++++++
 1 file changed, 16 insertions(+)

diff --git a/drivers/pmdomain/qcom/rpmhpd.c b/drivers/pmdomain/qcom/rpmhpd.c
index ee435d4c7..0abf8b7b4 100644
--- a/drivers/pmdomain/qcom/rpmhpd.c
+++ b/drivers/pmdomain/qcom/rpmhpd.c
@@ -122,6 +122,14 @@ static struct rpmhpd gbx = {
 static struct rpmhpd gfx = {
 	.pd = { .name = "gfx", },
 	.res_name = "gfx.lvl",
+	.presync_floor = true,
+};
+
+static struct rpmhpd gfx_gmu = {
+	.pd = { .name = "gfx", },
+	.res_name = "gfx.lvl",
+	.presync_floor = true,
+	.skip_retention_level = true,
 };
 
 static struct rpmhpd gfx_gmu = {
@@ -251,6 +259,14 @@ static struct rpmhpd qphy = {
 static struct rpmhpd gmxc = {
 	.pd = { .name = "gmxc", },
 	.res_name = "gmxc.lvl",
+	.presync_floor = true,
+};
+
+static struct rpmhpd gmxc_sm8750 = {
+	.pd = { .name = "gmxc", },
+	.res_name = "gmxc.lvl",
+	.presync_floor = true,
+	.skip_retention_level = true,
 };
 
 static struct rpmhpd gmxc_sm8750 = {
