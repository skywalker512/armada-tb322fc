From 5b77e055de4c5126172f92266737a503e2e44cd3 Mon Sep 17 00:00:00 2001
From: h0cheung <hcheunh@gmail.com>
Date: Tue, 6 Oct 2026 17:00:25 +0800
Subject: [PATCH 12/48] media: iris: allow larger capture buffer pools on HFI
 gen2

Threaded video clients can retain more than 32 decoded surfaces before
returning them to the decoder (VLC via VA-API does this with its default
frame threading), and the default vb2 limit of 32 buffers stops them from
allocating the capture pool they need.

Raise the HFI gen2 decoder CAPTURE queue limit to DEFAULT_MAX_HOST_BUF_COUNT
(64). This only raises what userspace may request; the minimum allocation,
the OUTPUT queue and the encoder queues are unchanged.

Cherry-picked via BigfootACA/linux full-v7.1.3 (b0e8638b5b), the Xiaomi Pad 8
Pro (xiaomi-piano, SM8750) mainline tree.
---
 drivers/media/platform/qcom/iris/iris_vidc.c | 3 +++
 1 file changed, 3 insertions(+)

diff --git a/drivers/media/platform/qcom/iris/iris_vidc.c b/drivers/media/platform/qcom/iris/iris_vidc.c
index 1c052ca23..70605b870 100644
--- a/drivers/media/platform/qcom/iris/iris_vidc.c
+++ b/drivers/media/platform/qcom/iris/iris_vidc.c
@@ -121,6 +121,9 @@ iris_m2m_queue_init(void *priv, struct vb2_queue *src_vq, struct vb2_queue *dst_
 	dst_vq->drv_priv = inst;
 	dst_vq->buf_struct_size = sizeof(struct iris_buffer);
 	dst_vq->min_reqbufs_allocation = MIN_BUFFERS;
+	if (inst->domain == DECODER &&
+	    inst->core->iris_firmware_data == &iris_hfi_gen2_data)
+		dst_vq->max_num_buffers = DEFAULT_MAX_HOST_BUF_COUNT;
 	dst_vq->dev = inst->core->dev;
 	dst_vq->lock = &inst->ctx_q_lock;
 
