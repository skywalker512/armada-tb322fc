From 1a11b03b7e1daeb3af001380465306e5abcf8161 Mon Sep 17 00:00:00 2001
From: h0cheung <hcheunh@gmail.com>
Date: Tue, 6 Oct 2026 17:00:07 +0800
Subject: [PATCH 11/48] media: iris: defer Gen2 DPB buffer destruction

iris_hfi_gen2_handle_release_internal_buffer() destroyed a DPB buffer as soon
as the firmware released it, but the firmware can still reference it during
streamoff. Mark it BUF_ATTR_PENDING_RELEASE and leave it to the deferred
release path instead, and skip such buffers in
iris_destroy_internal_buffers() unless the teardown is forced.

Cherry-picked from upstream (fe41e5e55fbe) via BigfootACA/linux full-v7.1.3
(05de9a1f8e), the Xiaomi Pad 8 Pro (xiaomi-piano, SM8750) mainline tree.
---
 drivers/media/platform/qcom/iris/iris_buffer.c           | 9 +++------
 .../media/platform/qcom/iris/iris_hfi_gen2_response.c    | 4 ++++
 2 files changed, 7 insertions(+), 6 deletions(-)

diff --git a/drivers/media/platform/qcom/iris/iris_buffer.c b/drivers/media/platform/qcom/iris/iris_buffer.c
index 246ad0abb..c87ae96eb 100644
--- a/drivers/media/platform/qcom/iris/iris_buffer.c
+++ b/drivers/media/platform/qcom/iris/iris_buffer.c
@@ -722,12 +722,9 @@ static int iris_destroy_internal_buffers(struct iris_inst *inst, u32 plane, bool
 	for (i = 0; i < len; i++) {
 		buffers = &inst->buffers[internal_buf_type[i]];
 		list_for_each_entry_safe(buf, next, &buffers->list, list) {
-			/*
-			 * during stream on, skip destroying internal(DPB) buffer
-			 * if firmware did not return it.
-			 * during close, destroy all buffers irrespectively.
-			 */
-			if (!force && buf->attr & BUF_ATTR_QUEUED)
+			if (!force && (buf->attr & BUF_ATTR_QUEUED ||
+			    (buf->type == BUF_DPB &&
+			     buf->attr & BUF_ATTR_PENDING_RELEASE)))
 				continue;
 
 			ret = iris_destroy_internal_buffer(inst, buf);
diff --git a/drivers/media/platform/qcom/iris/iris_hfi_gen2_response.c b/drivers/media/platform/qcom/iris/iris_hfi_gen2_response.c
index 770625541..3d1aa34dc 100644
--- a/drivers/media/platform/qcom/iris/iris_hfi_gen2_response.c
+++ b/drivers/media/platform/qcom/iris/iris_hfi_gen2_response.c
@@ -447,6 +447,10 @@ static int iris_hfi_gen2_handle_release_internal_buffer(struct iris_inst *inst,
 		return -EINVAL;
 
 	buf->attr &= ~BUF_ATTR_QUEUED;
+	if (buf->type == BUF_DPB) {
+		buf->attr |= BUF_ATTR_PENDING_RELEASE;
+		return 0;
+	}
 
 	return iris_destroy_internal_buffer(inst, buf);
 }
