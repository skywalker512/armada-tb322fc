From 530afadb5387343edc89a2d3884abe7644a226b7 Mon Sep 17 00:00:00 2001
From: h0cheung <hcheunh@gmail.com>
Date: Wed, 7 Oct 2026 21:32:33 +0800
Subject: [PATCH 19/48] wifi: ath12k: keep the RX refill ring from running dry

On WCN7850-class chips RX can stop for good after minutes of heavy
traffic: beacon loss, "failed to flush transmit queue, data pkts pending
1", and every later connection gets as far as association and then times
out in the 4-way handshake, while scans keep working. The host refill ring
is empty and nothing refills it:

 - the setup fill posts one ring's worth of buffers and on chips with
   per-MAC buffer rings the firmware moves them on into the MAC rings, so
   the rings only circulate that many out of a much larger descriptor pool;
 - a buffer that is not posted back (dev_alloc_skb() or DMA mapping
   failure, a dropped descriptor) is never made up for;
 - ath12k_wifi7_dp_rx_process() skips the replenish when it reaped buffers
   but no complete MSDU, losing those descriptors and leaking the skbs;
 - once the ring is empty RXDMA has nothing to write into, nothing reaches
   the REO destination rings, nothing is reaped and nothing refills the
   ring. WCN7850-class chips have no host2rxdma low-threshold interrupt
   that would break the loop.

Post the reaped buffers back even when no complete MSDU was reaped, top up
a deficit larger than 1/8 of the ring from the free list in the replenish
path, and add a deferrable 1 s timer that completes the initial fill and
then refills the ring when it is more than half empty, warning only when
nothing was reaped since the previous run (i.e. when RX would have
stalled). Count the failures and show them with the ring fill level in
device_dp_stats.

TB322FC sees the same ath12k MHI wedge that the WiFi watchdog currently
papers over; this is a candidate for the root cause.

Imported from joonhoekim/tb323fu-linux kernel/patches/0113 (Joonhoe Kim
<26rote@gmail.com>), ported onto this tree.
---
 drivers/net/wireless/ath/ath12k/debugfs.c     |  31 ++++-
 drivers/net/wireless/ath/ath12k/dp.c          |   3 +
 drivers/net/wireless/ath/ath12k/dp.h          |  23 ++++
 drivers/net/wireless/ath/ath12k/dp_rx.c       | 116 +++++++++++++++++-
 drivers/net/wireless/ath/ath12k/dp_rx.h       |   1 +
 drivers/net/wireless/ath/ath12k/wifi7/dp_rx.c |  14 ++-
 6 files changed, 181 insertions(+), 7 deletions(-)

diff --git a/drivers/net/wireless/ath/ath12k/debugfs.c b/drivers/net/wireless/ath/ath12k/debugfs.c
index d17d4a8f1..548453b45 100644
--- a/drivers/net/wireless/ath/ath12k/debugfs.c
+++ b/drivers/net/wireless/ath/ath12k/debugfs.c
@@ -1031,7 +1031,11 @@ static ssize_t ath12k_debugfs_dump_device_dp_stats(struct file *file,
 	struct ath12k_device_dp_stats *device_stats = &dp->device_stats;
 	int len = 0, i, j, ret;
 	struct ath12k *ar;
-	const int size = 4096;
+	const int size = 8192;
+	struct dp_rxdma_ring *rx_ring = &dp->rx_refill_buf_ring;
+	struct hal_srng *srng;
+	size_t free_descs;
+	int num_free;
 	static const char *rxdma_err[HAL_REO_ENTR_RING_RXDMA_ECODE_MAX] = {
 		[HAL_REO_ENTR_RING_RXDMA_ECODE_OVERFLOW_ERR] = "Overflow",
 		[HAL_REO_ENTR_RING_RXDMA_ECODE_MPDU_LEN_ERR] = "MPDU len",
@@ -1200,6 +1204,31 @@ static ssize_t ath12k_debugfs_dump_device_dp_stats(struct file *file,
 		len += scnprintf(buf + len, size - len, "\n");
 	}
 
+	srng = &dp->hal->srng_list[rx_ring->refill_buf_ring.ring_id];
+	spin_lock_bh(&srng->lock);
+	num_free = ath12k_hal_srng_src_num_free(ab, srng, true);
+	spin_unlock_bh(&srng->lock);
+	spin_lock_bh(&dp->rx_desc_lock);
+	free_descs = list_count_nodes(&dp->rx_desc_free_list);
+	spin_unlock_bh(&dp->rx_desc_lock);
+
+	len += scnprintf(buf + len, size - len,
+			 "\nRX refill ring: %d of %d free, free descriptors %zu\n",
+			 num_free, rx_ring->bufs_max, free_descs);
+	len += scnprintf(buf + len, size - len,
+			 "replenish alloc fail: %u map fail: %u no desc: %u\n",
+			 device_stats->rx_replenish_alloc_fail,
+			 device_stats->rx_replenish_map_fail,
+			 device_stats->rx_replenish_no_desc);
+	len += scnprintf(buf + len, size - len,
+			 "reap without msdu: %u top-up bufs: %u watchdog runs: %u bufs: %u stalls: %u%s\n",
+			 device_stats->rx_reap_no_msdu,
+			 device_stats->rx_refill_topup_bufs,
+			 device_stats->rx_refill_wd_runs,
+			 device_stats->rx_refill_wd_bufs,
+			 device_stats->rx_refill_wd_stalls,
+			 dp->rx_refill_filling ? " (initial fill)" : "");
+
 	ret = simple_read_from_buffer(user_buf, count, ppos, buf, len);
 
 	return ret;
diff --git a/drivers/net/wireless/ath/ath12k/dp.c b/drivers/net/wireless/ath/ath12k/dp.c
index af5f11fc1..2be8d6c6e 100644
--- a/drivers/net/wireless/ath/ath12k/dp.c
+++ b/drivers/net/wireless/ath/ath12k/dp.c
@@ -1123,6 +1123,9 @@ static void ath12k_dp_cleanup(struct ath12k_base *ab)
 	if (!dp->ab)
 		return;
 
+	/* before the rx descriptors go away in ath12k_dp_cc_cleanup() */
+	ath12k_dp_rx_refill_wd_stop(dp);
+
 	ath12k_dp_link_desc_cleanup(ab, dp->link_desc_banks,
 				    HAL_WBM_IDLE_LINK, &dp->wbm_idle_ring);
 
diff --git a/drivers/net/wireless/ath/ath12k/dp.h b/drivers/net/wireless/ath/ath12k/dp.h
index f8cfc7bb2..60a5a8c96 100644
--- a/drivers/net/wireless/ath/ath12k/dp.h
+++ b/drivers/net/wireless/ath/ath12k/dp.h
@@ -449,6 +449,15 @@ struct ath12k_device_dp_stats {
 	u32 tx_enqueued[DP_TCL_NUM_RING_MAX];
 	u32 tx_completed[DP_TCL_NUM_RING_MAX];
 	u32 reo_excep_msdu_buf_type;
+	/* RX refill ring accounting */
+	u32 rx_replenish_alloc_fail;
+	u32 rx_replenish_map_fail;
+	u32 rx_replenish_no_desc;
+	u32 rx_reap_no_msdu;
+	u32 rx_refill_topup_bufs;
+	u32 rx_refill_wd_runs;
+	u32 rx_refill_wd_bufs;
+	u32 rx_refill_wd_stalls;
 };
 
 struct ath12k_dp {
@@ -506,6 +515,20 @@ struct ath12k_dp {
 	spinlock_t tx_desc_lock[ATH12K_HW_MAX_QUEUES];
 
 	struct dp_rxdma_ring rx_refill_buf_ring;
+	/* completes the initial fill of rx_refill_buf_ring and tops it up
+	 * when nothing is reaped any more
+	 */
+	struct timer_list rx_refill_wd;
+	struct ratelimit_state rx_refill_wd_rs;
+	/* buffers posted to rx_refill_buf_ring, under its srng lock */
+	u32 rx_refill_posted;
+	/* rx_refill_posted as of the last watchdog run */
+	u32 rx_refill_wd_posted;
+	/* rx_refill_posted at which the initial fill ends */
+	u32 rx_refill_fill_end;
+	bool rx_refill_wd_init;
+	/* the initial fill is still going on */
+	bool rx_refill_filling;
 	struct dp_srng rx_mac_buf_ring[MAX_RXDMA_PER_PDEV];
 	struct dp_srng rxdma_err_dst_ring[MAX_RXDMA_PER_PDEV];
 	struct dp_rxdma_mon_ring rxdma_mon_buf_ring;
diff --git a/drivers/net/wireless/ath/ath12k/dp_rx.c b/drivers/net/wireless/ath/ath12k/dp_rx.c
index 8fa0e90b4..f220c950d 100644
--- a/drivers/net/wireless/ath/ath12k/dp_rx.c
+++ b/drivers/net/wireless/ath/ath12k/dp_rx.c
@@ -7,6 +7,7 @@
 #include <linux/fips.h>
 #include <linux/ieee80211.h>
 #include <linux/kernel.h>
+#include <linux/ratelimit.h>
 #include <linux/skbuff.h>
 #include "core.h"
 #include "debug.h"
@@ -111,13 +112,30 @@ int ath12k_dp_rx_bufs_replenish(struct ath12k_dp *dp,
 						       num_remain);
 		spin_unlock_bh(&dp->rx_desc_lock);
 		num_remain = req_entries;
+	} else if (num_free - req_entries > rx_ring->bufs_max / 8) {
+		/* Also make up for buffers that were never posted back
+		 * (allocation or mapping failure, a dropped descriptor).
+		 */
+		LIST_HEAD(extra);
+		size_t n;
+
+		spin_lock_bh(&dp->rx_desc_lock);
+		n = ath12k_dp_list_cut_nodes(&extra, &dp->rx_desc_free_list,
+					     num_free - req_entries);
+		spin_unlock_bh(&dp->rx_desc_lock);
+		list_splice_tail(&extra, used_list);
+		req_entries += n;
+		num_remain = req_entries;
+		dp->device_stats.rx_refill_topup_bufs += n;
 	}
 
 	while (num_remain > 0) {
 		skb = dev_alloc_skb(DP_RX_BUFFER_SIZE +
 				    DP_RX_BUFFER_ALIGN_SIZE);
-		if (!skb)
+		if (!skb) {
+			dp->device_stats.rx_replenish_alloc_fail++;
 			break;
+		}
 
 		if (!IS_ALIGNED((unsigned long)skb->data,
 				DP_RX_BUFFER_ALIGN_SIZE)) {
@@ -129,14 +147,18 @@ int ath12k_dp_rx_bufs_replenish(struct ath12k_dp *dp,
 		paddr = dma_map_single(dp->dev, skb->data,
 				       skb->len + skb_tailroom(skb),
 				       DMA_FROM_DEVICE);
-		if (dma_mapping_error(dp->dev, paddr))
+		if (dma_mapping_error(dp->dev, paddr)) {
+			dp->device_stats.rx_replenish_map_fail++;
 			goto fail_free_skb;
+		}
 
 		rx_desc = list_first_entry_or_null(used_list,
 						   struct ath12k_rx_desc_info,
 						   list);
-		if (!rx_desc)
+		if (!rx_desc) {
+			dp->device_stats.rx_replenish_no_desc++;
 			goto fail_dma_unmap;
+		}
 
 		rx_desc->skb = skb;
 		cookie = rx_desc->cookie;
@@ -163,6 +185,7 @@ int ath12k_dp_rx_bufs_replenish(struct ath12k_dp *dp,
 	dev_kfree_skb_any(skb);
 out:
 	ath12k_hal_srng_access_end(ab, srng);
+	dp->rx_refill_posted += req_entries - num_remain;
 
 	if (!list_empty(used_list))
 		ath12k_dp_rx_enqueue_free(dp, used_list);
@@ -173,6 +196,83 @@ int ath12k_dp_rx_bufs_replenish(struct ath12k_dp *dp,
 }
 EXPORT_SYMBOL(ath12k_dp_rx_bufs_replenish);
 
+#define ATH12K_DP_RX_REFILL_WD_MS	1000
+
+/* The refill ring is only replenished from the reap paths, and WCN7850 has
+ * no host2rxdma low-threshold interrupt: once the ring runs dry nothing is
+ * reaped any more. Top it up from a timer, which also completes the initial
+ * fill from the descriptor pool.
+ */
+static void ath12k_dp_rx_refill_wd(struct timer_list *t)
+{
+	struct ath12k_dp *dp = timer_container_of(dp, t, rx_refill_wd);
+	struct dp_rxdma_ring *rx_ring = &dp->rx_refill_buf_ring;
+	struct ath12k_device_dp_stats *stats = &dp->device_stats;
+	struct ath12k_base *ab = dp->ab;
+	struct hal_srng *srng;
+	LIST_HEAD(list);
+	int num_free, n;
+	bool reaped;
+	u32 posted;
+
+	if (!test_bit(ATH12K_FLAG_EXT_IRQ_ENABLED, &ab->dev_flags) ||
+	    test_bit(ATH12K_FLAG_CRASH_FLUSH, &ab->dev_flags) ||
+	    test_bit(ATH12K_FLAG_RECOVERY, &ab->dev_flags))
+		goto rearm;
+
+	srng = &dp->hal->srng_list[rx_ring->refill_buf_ring.ring_id];
+	spin_lock_bh(&srng->lock);
+	num_free = ath12k_hal_srng_src_num_free(ab, srng, true);
+	posted = dp->rx_refill_posted;
+	spin_unlock_bh(&srng->lock);
+
+	/* whatever was posted since the last run came from a reap path */
+	reaped = posted != dp->rx_refill_wd_posted;
+	dp->rx_refill_wd_posted = posted;
+
+	if (dp->rx_refill_filling &&
+	    (s32)(posted - dp->rx_refill_fill_end) >= 0)
+		dp->rx_refill_filling = false;
+
+	if (num_free <= rx_ring->bufs_max / (dp->rx_refill_filling ? 8 : 2))
+		goto rearm;
+
+	n = ath12k_dp_rx_bufs_replenish(dp, rx_ring, &list, num_free);
+	dp->rx_refill_wd_posted += n;
+	stats->rx_refill_wd_runs++;
+	stats->rx_refill_wd_bufs += n;
+
+	/* Quiet during the initial fill. After it, a ring that runs low while
+	 * buffers are still reaped is only busy, and one that cannot be
+	 * refilled holds the whole pool already.
+	 */
+	if (dp->rx_refill_filling || reaped || !n)
+		goto rearm;
+
+	stats->rx_refill_wd_stalls++;
+	if (__ratelimit(&dp->rx_refill_wd_rs))
+		ath12k_warn(ab, "rx refill ring ran low with nothing reaped for %u ms: %d of %d free, posted %d (alloc fail %u, map fail %u, no desc %u, stalls %u)\n",
+			    ATH12K_DP_RX_REFILL_WD_MS, num_free,
+			    rx_ring->bufs_max, n,
+			    stats->rx_replenish_alloc_fail,
+			    stats->rx_replenish_map_fail,
+			    stats->rx_replenish_no_desc,
+			    stats->rx_refill_wd_stalls);
+
+rearm:
+	mod_timer(&dp->rx_refill_wd,
+		  jiffies + msecs_to_jiffies(ATH12K_DP_RX_REFILL_WD_MS));
+}
+
+void ath12k_dp_rx_refill_wd_stop(struct ath12k_dp *dp)
+{
+	if (!dp->rx_refill_wd_init)
+		return;
+
+	timer_shutdown_sync(&dp->rx_refill_wd);
+	dp->rx_refill_wd_init = false;
+}
+
 static int ath12k_dp_rxdma_mon_buf_ring_free(struct ath12k_base *ab,
 					     struct dp_rxdma_mon_ring *rx_ring)
 {
@@ -1592,6 +1692,7 @@ void ath12k_dp_rx_free(struct ath12k_base *ab)
 	struct dp_srng *srng;
 	int i;
 
+	ath12k_dp_rx_refill_wd_stop(dp);
 	ath12k_dp_srng_cleanup(ab, &dp->rx_refill_buf_ring.refill_buf_ring);
 
 	for (i = 0; i < ab->hw_params->num_rxdma_per_pdev; i++) {
@@ -1760,12 +1861,21 @@ int ath12k_dp_rx_alloc(struct ath12k_base *ab)
 		}
 	}
 
+	dp->rx_refill_fill_end = dp->rx_refill_posted + ATH12K_RX_DESC_COUNT(ab);
 	ret = ath12k_dp_rxdma_buf_setup(ab);
 	if (ret) {
 		ath12k_warn(ab, "failed to setup rxdma ring\n");
 		return ret;
 	}
 
+	ratelimit_state_init(&dp->rx_refill_wd_rs, 60 * HZ, 1);
+	dp->rx_refill_wd_posted = dp->rx_refill_posted;
+	dp->rx_refill_filling = true;
+	timer_setup(&dp->rx_refill_wd, ath12k_dp_rx_refill_wd, TIMER_DEFERRABLE);
+	dp->rx_refill_wd_init = true;
+	mod_timer(&dp->rx_refill_wd,
+		  jiffies + msecs_to_jiffies(ATH12K_DP_RX_REFILL_WD_MS));
+
 	return 0;
 }
 
diff --git a/drivers/net/wireless/ath/ath12k/dp_rx.h b/drivers/net/wireless/ath/ath12k/dp_rx.h
index 0660db070..aac28d4c5 100644
--- a/drivers/net/wireless/ath/ath12k/dp_rx.h
+++ b/drivers/net/wireless/ath/ath12k/dp_rx.h
@@ -225,6 +225,7 @@ void ath12k_dp_rx_pdev_reo_cleanup(struct ath12k_base *ab);
 int ath12k_dp_rx_htt_setup(struct ath12k_base *ab);
 int ath12k_dp_rx_alloc(struct ath12k_base *ab);
 void ath12k_dp_rx_free(struct ath12k_base *ab);
+void ath12k_dp_rx_refill_wd_stop(struct ath12k_dp *dp);
 int ath12k_dp_rx_pdev_alloc(struct ath12k_base *ab, int pdev_idx);
 void ath12k_dp_rx_pdev_free(struct ath12k_base *ab, int pdev_idx);
 void ath12k_dp_rx_reo_cmd_list_cleanup(struct ath12k_base *ab);
diff --git a/drivers/net/wireless/ath/ath12k/wifi7/dp_rx.c b/drivers/net/wireless/ath/ath12k/wifi7/dp_rx.c
index 95d87dd67..926635319 100644
--- a/drivers/net/wireless/ath/ath12k/wifi7/dp_rx.c
+++ b/drivers/net/wireless/ath/ath12k/wifi7/dp_rx.c
@@ -789,9 +789,9 @@ int ath12k_wifi7_dp_rx_process(struct ath12k_dp *dp, int ring_id,
 
 	spin_unlock_bh(&srng->lock);
 
-	if (!total_msdu_reaped)
-		goto exit;
-
+	/* Post the reaped buffers back even if no complete MSDU was reaped,
+	 * or they are lost.
+	 */
 	for (device_id = 0; device_id < ATH12K_MAX_DEVICES; device_id++) {
 		if (!num_buffs_reaped[device_id])
 			continue;
@@ -802,6 +802,14 @@ int ath12k_wifi7_dp_rx_process(struct ath12k_dp *dp, int ring_id,
 		ath12k_dp_rx_bufs_replenish(partner_dp, rx_ring,
 					    &rx_desc_used_list[device_id],
 					    num_buffs_reaped[device_id]);
+
+		if (!total_msdu_reaped)
+			dp->device_stats.rx_reap_no_msdu++;
+	}
+
+	if (!total_msdu_reaped) {
+		__skb_queue_purge(&msdu_list);
+		goto exit;
 	}
 
 	ath12k_wifi7_dp_rx_process_received_packets(dp, napi, &msdu_list,
